--- a/src/xtiming.h
+++ b/src/xtiming.h
@@ -0,0 +1,41 @@
+/* Timing hooks for speed measurements (not part of xfig 3.2.9a).
+ * Active only when the environment variable XFIG_TIMING is set to something other than "0";
+ * otherwise every hook does nothing.  Each measured span ends with XSync(), so the X server's
+ * drawing is included, and is printed to stderr as
+ *     XT <name> <start, CLOCK_MONOTONIC ms> <duration ms>
+ */
+#ifndef XTIMING_H
+#define XTIMING_H
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <X11/Xlib.h>
+extern Display *tool_d;
+static inline double xt_now(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6;
+}
+static inline int xt_on(void)
+{
+    static int v = -1;
+    if (v < 0) {
+	const char *e = getenv("XFIG_TIMING");
+	v = (e && *e && *e != '0');
+    }
+    return v;
+}
+static inline double xt_begin(void) { return xt_on() ? xt_now() : 0.0; }
+static inline void xt_end(const char *what, double t0)
+{
+    double t1;
+    if (!xt_on())
+	return;
+    if (tool_d)
+	XSync(tool_d, False);
+    t1 = xt_now();
+    fprintf(stderr, "XT %s %.3f %.3f\n", what, t0, t1 - t0);
+    fflush(stderr);
+}
+#endif
